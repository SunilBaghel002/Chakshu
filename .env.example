# ==============================================================================
# Chakshu Environment Configuration
# ==============================================================================
# All secrets and local runtime parameters belong here.
# Copy this file to .env and adjust as needed. NEVER commit .env.

# --- Database (Supabase IPv4 Session Pooler) ---
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- Frontend & Backend Cross-Origin Connection ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*
VITE_BASE_URL=/api/v1
VITE_API_BASE=/api/v1

# --- Offline / Air-Gapped Mode ---
OFFLINE=0

# --- Gemini (Tier 2 phrasing and Tier 3 object detection) ---
GEMINI_ENABLED=1
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BBOX_ORDER=yxyx

# --- Upload Limits ---
UPLOAD_MAX_MB_GEO=500
UPLOAD_MAX_MB_RGB=25

# --- Embeddings & Corroborating Models ---
CLIP_MODEL=ViT-B-32
TINYCD_ENABLED=0

# --- Detection & Analysis Thresholds ---
DETECTION_SCORE_MIN=0.50
DETECTION_NMS_IOU=0.50
MERGE_IOU_THRESHOLD=0.30
INTENT_MATCH_THRESHOLD=0.72

# --- Demo & Telemetry ---
DEMO_SITE_DEFAULT=jewar
VITE_MOCK=0
VITE_TELEMETRY=on
NEXT_PUBLIC_TELEMETRY=on

# --- Identity & Admin Authentication ---
ENV=dev
SERVER_SECRET=dev-secret-key-chakshu-2026
ADMIN_EMAIL=admin@chakshu.internal
ADMIN_PASSWORD=Admin@12345
