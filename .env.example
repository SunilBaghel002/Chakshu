# ==============================================================================
# Chakshu Environment Configuration
# ==============================================================================
# All secrets and local runtime parameters belong here.
# Copy this file to .env and adjust as needed. NEVER commit .env.

# --- Database ---
# Postgres 17 with PostGIS 3.4 and pgvector 0.8
DATABASE_URL=postgresql+psycopg://chakshu:chakshu@localhost:5432/chakshu

# --- Offline / Air-Gapped Mode ---
# 1 = No outbound HTTP whatsoever. Adapters raise OfflineError immediately.
# 0 = Cloud APIs allowed when configured.
OFFLINE=0

# --- Gemini (Tier 2 phrasing and Tier 3 object detection) ---
# Active only when OFFLINE=0 and GEMINI_ENABLED=1
GEMINI_ENABLED=0
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Bounding box convention: "yxyx" [ymin, xmin, ymax, xmax] or "xyxy" [xmin, ymin, xmax, ymax]
GEMINI_BBOX_ORDER=yxyx

# --- Upload Limits ---
UPLOAD_MAX_MB_GEO=500
UPLOAD_MAX_MB_RGB=25

# --- Embeddings & Corroborating Models ---
CLIP_MODEL=ViT-B-32
TINYCD_ENABLED=0

# --- Detection & Analysis Thresholds ---
DETECTION_SCORE_MIN=0.50
DETECTION_NMS_IOU=0.50
MERGE_IOU_THRESHOLD=0.30
INTENT_MATCH_THRESHOLD=0.72

# --- Storage Paths ---
DATA_DIR=data
CACHE_DIR=data/cache
UPLOADS_DIR=data/uploads
SCENES_DIR=data/scenes
MASKS_DIR=data/masks
TILES_DIR=data/tiles
